{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TainanAssessmentReportV2",
  "description": "研判单元契约 v2.0：观点/判断优先，近期事实作为佐证。结论摘要(<=3) -> 核心研判(1-3) -> 附录。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "election_id",
    "report_period",
    "generation_mode",
    "report_status",
    "title",
    "conclusion_summary",
    "core_assessments",
    "appendix",
    "required_disclosures",
    "do_not_infer_compliance",
    "report_statistics",
    "data_context"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "2.0"},
    "report_id": {"type": "string", "minLength": 1},
    "election_id": {"type": "string", "minLength": 1},
    "report_period": {"type": "object", "additionalProperties": true},
    "generation_mode": {"type": "string", "enum": ["final", "draft_with_data_gap"]},
    "report_status": {"type": "string", "enum": ["generated", "repaired", "rejected"]},
    "title": {"type": "string", "minLength": 1},
    "conclusion_summary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary_id", "judgment", "confidence", "evidence_refs"],
        "properties": {
          "summary_id": {"type": "string", "minLength": 1},
          "judgment": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
        }
      }
    },
    "core_assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assessment_id",
          "judgment",
          "evidence_items",
          "evidence_refs",
          "reasoning",
          "falsifiers_or_limits",
          "confidence",
          "watch_indicators"
        ],
        "properties": {
          "assessment_id": {"type": "string", "minLength": 1},
          "judgment": {"type": "string", "minLength": 1},
          "evidence_items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_id", "evidence_date", "evidence_summary"],
              "properties": {
                "evidence_id": {"type": "string", "minLength": 1},
                "evidence_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "evidence_summary": {"type": "string", "minLength": 1}
              }
            }
          },
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
          "reasoning": {"type": "string", "minLength": 1},
          "falsifiers_or_limits": {"type": "string", "minLength": 1},
          "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
          "watch_indicators": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "appendix": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "item_type", "item_text", "evidence_refs"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "item_type": {"type": "string", "enum": ["background_fact", "data_limitation", "disclosure"]},
          "item_text": {"type": "string", "minLength": 1},
          "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
        }
      }
    },
    "required_disclosures": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "do_not_infer_compliance": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "rule_text", "violated", "related_claim_ids"],
        "properties": {
          "rule_id": {"type": "string"},
          "rule_text": {"type": "string"},
          "violated": {"type": "boolean"},
          "related_claim_ids": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "report_statistics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_count",
        "section_count",
        "core_assessment_count",
        "conclusion_summary_count",
        "evidence_item_count",
        "chinese_char_count",
        "length_below_target"
      ],
      "properties": {
        "claim_count": {"type": "integer"},
        "section_count": {"type": "integer"},
        "core_assessment_count": {"type": "integer"},
        "conclusion_summary_count": {"type": "integer"},
        "evidence_item_count": {"type": "integer"},
        "event_reference_count": {"type": "integer"},
        "poll_reference_count": {"type": "integer"},
        "source_reference_count": {"type": "integer"},
        "gap_reference_count": {"type": "integer"},
        "chinese_char_count": {"type": "integer"},
        "length_below_target": {"type": "boolean"}
      }
    },
    "data_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_snapshot_id",
        "previous_snapshot_id",
        "coverage_version",
        "facts_cutoff",
        "poll_cutoff",
        "period_start",
        "period_end",
        "uncovered_date_range"
      ],
      "properties": {
        "active_snapshot_id": {"type": "string"},
        "previous_snapshot_id": {"type": "string"},
        "coverage_version": {"type": "string"},
        "facts_cutoff": {"type": "string"},
        "poll_cutoff": {"type": "string"},
        "period_start": {"type": "string"},
        "period_end": {"type": "string"},
        "uncovered_date_range": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "evidence_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_ids": {"type": "array", "items": {"type": "string"}},
        "poll_ids": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "gap_ids": {"type": "array", "items": {"type": "string"}},
        "dimension_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
