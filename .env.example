# Notification backend: console, feishu, or telegram
NOTIFIER=console

# Feishu webhook notifier
FEISHU_WEBHOOK_URL=

# Telegram notifier
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional development database and logging settings
DATABASE_PATH=data/news-dev.db
LOG_LEVEL=INFO

# Feishu application bot
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=
FEISHU_RECEIVE_ID_TYPE=chat_id
